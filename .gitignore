# Keil 和 MDK-ARM 编译输出
/code/MDK-ARM/code/
/code/MDK-ARM/*.log
/code/MDK-ARM/*.lst
/code/MDK-ARM/*.uvguix.*
/code/MDK-ARM/*.bak
/code/MDK-ARM/*.tmp

# 常见嵌入式编译产物
/code/**/*.o
/code/**/*.obj
/code/**/*.d
/code/**/*.crf
/code/**/*.axf
/code/**/*.elf
/code/**/*.hex
/code/**/*.bin
/code/**/*.map
/code/**/*.lnp
/code/**/*.dep
/code/**/*.build_log.htm

# Python 和工具运行产物及生成的报告
__pycache__/
*.py[cod]
/sch*.txt
**/log/
analysis_output*/
output/
tmp/

# PCB：仅保留发布压缩包，忽略源文件目录和 Altium 历史备份
/pcb/**
!/pcb/**/
!/pcb/**/*.zip
!/pcb/**/*.7z
!/pcb/**/*.rar
/pcb/**/History/

# 操作系统和编辑器临时文件
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

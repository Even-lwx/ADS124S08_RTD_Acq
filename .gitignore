# Keil 和 MDK-ARM 编译输出
/code/MDK-ARM/code/
/code/MDK-ARM/*.log
/code/MDK-ARM/*.lst
/code/MDK-ARM/*.uvguix.*
/code/MDK-ARM/*.bak
/code/MDK-ARM/*.tmp

# 常见嵌入式编译产物
/code/**/*.o
/code/**/*.obj
/code/**/*.d
/code/**/*.crf
/code/**/*.axf
/code/**/*.elf
/code/**/*.hex
/code/**/*.bin
/code/**/*.map
/code/**/*.lnp
/code/**/*.dep
/code/**/*.build_log.htm

# Python 和工具运行产物及生成的报告
__pycache__/
*.py[cod]
/sch*.txt
**/log/
analysis_output*/
output/
tmp/

# PCB：保留原理图、PCB、工程和元件库，忽略可生成的历史与输出
/pcb/**/History/
/pcb/**/__Previews/
/pcb/**/Project Logs*/
/pcb/**/Project Outputs*/

# 原理图解析文本可以从源文件重新生成，保留在本机供复核
/analysis/schematic/*.txt

# 第三方调试工具运行时日志和本机串口设置
/tools/qModMaster-Win64-exe-0.5.3-beta/**/*.log*
/tools/qModMaster-Win64-exe-0.5.3-beta/**/*.ini

# 操作系统和编辑器临时文件
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
